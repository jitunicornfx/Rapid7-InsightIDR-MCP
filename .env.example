# Rapid7 InsightIDR MCP server configuration.
# Copy to `.env` and fill in, or export these variables in your MCP client config.

# REQUIRED: Insight platform API key (Administration > API Keys > Organization key).
INSIGHTIDR_API_KEY=your-insight-platform-api-key

# OPTIONAL: Insight region code. One of: us, us2, us3, eu, ca, au, ap. Defaults to "us".
INSIGHTIDR_REGION=us

# OPTIONAL: Override the full base URL (advanced / testing only).
# Defaults to https://<region>.api.insight.rapid7.com
# INSIGHTIDR_BASE_URL=https://us.api.insight.rapid7.com

# OPTIONAL: Override the v1 API base URL.
# Defaults to https://<region>.api.insight.rapid7.com — the same host as v2. (Specs up to v1.3.0.3
# claimed the rest.logs host, where no /idr/v1/ route is served; Rapid7 corrected that in v1.3.1.0.)
# INSIGHTIDR_V1_BASE_URL=https://us.api.insight.rapid7.com

# OPTIONAL: Override the Log Search API base URL.
# Defaults to https://<region>.rest.logs.insight.rapid7.com (per the Log Search spec's servers).
# Set this to the unified platform route if preferred:
# INSIGHTIDR_LOG_SEARCH_BASE_URL=https://us.api.insight.rapid7.com/log_search

# OPTIONAL: Per-request timeout in milliseconds. Defaults to 60000.
# INSIGHTIDR_TIMEOUT_MS=60000

# --http mode only: the bearer token every request must present ("Authorization: Bearer <token>").
# REQUIRED when --host is anything but a loopback address: the server refuses to start without it,
# because it holds your API key and would otherwise hand every tool to anyone who can reach the port.
# Recommended on loopback too. At least 16 characters; generate one with: openssl rand -hex 32
# INSIGHTIDR_HTTP_TOKEN=

# OPTIONAL (--http mode only): comma-separated browser origins allowed via CORS.
# Empty (default) denies all cross-origin browser access; non-browser MCP clients are unaffected.
# Never use "*". Example:
# INSIGHTIDR_HTTP_ALLOWED_ORIGINS=https://app.example.com,https://another.example.com:8443

# OPTIONAL: skip the startup check for a newer release on GitHub. The check is unauthenticated,
# best-effort, and never blocks startup; set this in air-gapped or egress-restricted deployments.
# Implies no automatic installation. Equivalent to passing --no-update-check.
# INSIGHTIDR_DISABLE_UPDATE_CHECK=1

# OPTIONAL: keep being told about new releases, but never download or install them. By default a
# newer release is downloaded, verified against the SHA-256 GitHub publishes for it, and swapped in
# (it takes effect on the next restart). Because that is code execution from a remote source, set
# this if you would rather update manually. Equivalent to passing --no-auto-update.
# INSIGHTIDR_DISABLE_AUTO_UPDATE=1

# OPTIONAL: maximum characters of API data in one tool result. Defaults to 200000 (~4 chars per
# token, so roughly 50k tokens). Larger results are re-rendered compactly, then structurally
# trimmed, then cut, always with a notice saying what was dropped. Raise it for a model with a
# bigger context window. 1-1999 is raised to 2000; 0 or less means the default: there is no "unlimited".
# INSIGHTIDR_MAX_RESULT_CHARS=200000

# OPTIONAL: where logsearch_spool_query_to_file writes results. Defaults to
# ~/.rapid7-insightidr-mcp/spool. These files hold tenant log data and are created readable only by
# the user running the server; point this at a larger volume if you spool big result sets.
# INSIGHTIDR_SPOOL_DIR=/var/spool/insightidr-mcp

# OPTIONAL: hours a spooled result survives before it is swept at startup. Defaults to 24.
# Set to 0 to never sweep, e.g. when the files must be preserved as evidence.
# INSIGHTIDR_SPOOL_RETENTION_HOURS=24

# OPTIONAL: the ONE directory upload_attachment may read files from. Unset (the default), that tool
# is disabled: it sends a local file to Rapid7 at a path the model chooses, so it stays off until you
# say where it may look. Only files inside this directory can ever be uploaded.
# INSIGHTIDR_UPLOAD_DIR=/srv/insightidr-mcp/uploads
